---
import Base from '../layouts/Base.astro'; import PageHeader from '../components/PageHeader.astro'; import GlobalCTA from '../components/GlobalCTA.astro';
const services=[['Scaffolding hire','Quality equipment for projects of every size.'],['Scaffolding installation','Experienced crews who work safely around your program.'],['Labour','Skilled scaffolders available when your site needs support.'],['Transport','Reliable movement of equipment to and from site.'],['Design','Practical access planning for complex conditions.'],['Consulting engineering','Engineer-supported scaffolding solutions for your project.']];
---
<Base title="Services | Secure Scaffolding" description="Scaffolding hire, installation, labour, transport and engineering support across Sydney, the Central Coast and Newcastle." current="services"><main><PageHeader eyebrow="Our services" title="Access, handled." intro="A flexible service offering for the pace and complexity of modern construction." /><section class="section" style="padding-top:0"><div class="wrap"><div class="service-cards">{services.map(([title,description],i)=><article class="service-card"><span>0{i+1}</span><h2>{title}</h2><p>{description}</p><a href="/contact">Talk to our team ↗</a></article>)}</div></div></section><section class="section band"><div class="wrap split"><div><div class="eyebrow" style="color:#d7f54b">Our approach</div><h2>Safe, practical, on schedule.</h2></div><p class="lead">We work alongside your team to understand the site, coordinate the details and deliver access that keeps the project moving.</p></div></section><div class="wrap"><GlobalCTA /></div></main><style>.service-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.service-card{padding:26px;border:1px solid var(--line);border-radius:16px;background:#fff;min-height:220px;transition:.2s}.service-card:hover{transform:translateY(-3px);border-color:#b8cc36;box-shadow:0 12px 30px rgba(16,17,18,.08)}.service-card>span{color:#98ab22;font-weight:900}.service-card h2{font-size:1.35rem;letter-spacing:-.04em;margin:42px 0 8px}.service-card p{color:var(--muted);margin:0 0 22px}.service-card a{font-weight:800;font-size:.85rem}@media(max-width:800px){.service-cards{grid-template-columns:repeat(2,1fr)}}@media(max-width:480px){.service-cards{grid-template-columns:1fr}}</style></Base>
