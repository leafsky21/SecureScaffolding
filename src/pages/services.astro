---
import Base from '../layouts/Base.astro'; import PageHeader from '../components/PageHeader.astro';
const services=['Scaffolding hire','Scaffolding installation','Labour','Transport','Design','Consulting engineering (scaffolding purposes)'];
---
<Base title="Services | Secure Scaffolding" description="Scaffolding hire, installation, labour, transport and engineering support across Sydney, the Central Coast and Newcastle." current="services"><main><PageHeader eyebrow="Our services" title="Access, handled." intro="A flexible service offering for the pace and complexity of modern construction." /><section class="section" style="padding-top:0"><div class="wrap"><div class="list">{services.map((service,i)=><div class="list-row"><span style="color:#98ab22;font-weight:900">0{i+1}</span><strong>{service}</strong><span>Talk to us ↗</span></div>)}</div></div></section><section class="section band"><div class="wrap split"><div><div class="eyebrow" style="color:#d7f54b">Our approach</div><h2>Safe, practical, on schedule.</h2></div><p class="lead">We work alongside your team to understand the site, coordinate the details and deliver access that keeps the project moving.</p></div></section></main></Base>
