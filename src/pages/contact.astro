<Base title="Contact | Secure Scaffolding" description="Contact Secure Scaffolding for scaffold hire, installation, transport and design support in NSW." current="contact"><main><PageHeader eyebrow="Start a conversation" title="Tell us about your project." intro="Share a few details and our team will get back to you. For urgent enquiries, call us directly." /><section class="section" style="padding-top:0"><div class="wrap contact-grid"><div><div class="contact-item"><b>Visit</b>5 Gundah Road<br />Mount Kuring-Gai NSW 2080</div><div class="contact-item"><b>Phone</b><a href="tel:+61294570133">02 9457 0133</a><br /><a href="tel:+6141259864">0412 598 864</a></div><div class="contact-item"><b>Email</b><a href="mailto:info@securescaffolding.com.au">info@securescaffolding.com.au</a></div><div class="contact-item"><b>Social</b><a href="https://www.instagram.com/securescaffolding1" rel="noreferrer">Instagram ↗</a></div></div><form class="form" action="https://formspree.io/f/REPLACE_WITH_FORM_ID" method="POST"><label>Name *<input name="name" required autocomplete="name" /></label><label>Email *<input name="email" type="email" required autocomplete="email" /></label><label>Subject<input name="subject" /></label><label>Message<textarea name="message" required></textarea></label><label class="honeypot" aria-hidden="true">Company<input name="company" tabindex="-1" autocomplete="off" /></label><input type="hidden" name="_subject" value="New Secure Scaffolding enquiry" /><button class="btn btn-primary" type="submit">Send enquiry ↗</button><p class="eyebrow" style="margin-bottom:0;margin-top:18px">Spam protection: configure Formspree Turnstile or Cloudflare Turnstile before launch.</p></form></div></section></main></Base>
