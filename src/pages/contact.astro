---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---

<Base
  title="Contact Secure Scaffolding Sydney | Request a Quote"
  description="Request a scaffolding quote for hire, installation, transport, commercial scaffolding or specialist access across Sydney and NSW."
  current="contact"
>
  <main>
    <PageHeader
      eyebrow="Scaffolding enquiries"
      title="Tell us about your Sydney scaffolding project."
      intro="Share the site location, project type, program and access requirements. For urgent enquiries, call our Mount Kuring-Gai office directly."
    />
    <section class="section" style="padding-top:0">
      <div class="wrap contact-grid">
        <div>
          <div class="contact-item"><b>Visit</b>5 Gundah Road<br />Mount Kuring-Gai NSW 2080</div>
          <div class="contact-item"><b>Phone</b><a href="tel:+61294570133">02 9457 0133</a><br /><a href="tel:+6141259864">0412 598 864</a></div>
          <div class="contact-item"><b>Email</b><a href="mailto:info@securescaffolding.com.au">info@securescaffolding.com.au</a></div>
          <div class="contact-item"><b>Service areas</b><a href="/service-areas/">Sydney, Central Coast and Newcastle ↗</a></div>
          <div class="contact-item"><b>Social</b><a href="https://www.instagram.com/securescaffolding1" rel="noreferrer">Instagram ↗</a></div>
        </div>
        <form class="form" id="contact-form" action="https://formspree.io/f/mqpzypel" method="POST">
          <label>Name *<input name="name" required autocomplete="name" /></label>
          <label>Email *<input name="email" type="email" required autocomplete="email" /></label>
          <label>Subject<input name="subject" /></label>
          <label>Message<textarea name="message" required></textarea></label>
          <label class="honeypot" aria-hidden="true">Company<input name="company" tabindex="-1" autocomplete="off" /></label>
          <input type="hidden" name="_subject" value="New Secure Scaffolding enquiry" />
          <button class="btn btn-primary" type="submit">Send enquiry ↗</button>
          <p class="eyebrow" id="form-status" role="status" aria-live="polite" style="margin-bottom:0;margin-top:18px;color:#667078">Spam protection is handled by the configured Formspree form.</p>
        </form>
      </div>
    </section>
  </main>
  <script>
    const form = document.querySelector('#contact-form');
    const status = document.querySelector('#form-status');
    form?.addEventListener('submit', async event => {
      event.preventDefault();
      const button = form.querySelector('button');
      button.disabled = true;
      button.textContent = 'Sending…';
      status.textContent = 'Sending your enquiry…';
      status.style.color = '#667078';
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        const result = await response.json().catch(() => ({}));
        if (!response.ok) {
          const raw = result.errors?.map(item => item.message || item.code).filter(Boolean).join(' ') || result.error || 'Please check the information entered and try again.';
          const detail = /should be an email/i.test(raw) ? 'Please enter a valid email address.' : raw;
          throw new Error(detail);
        }
        form.reset();
        status.textContent = 'Message sent successfully. We’ll be in touch soon.';
        status.style.color = '#4e7000';
      } catch (error) {
        status.textContent = 'Error: ' + (error.message || 'We couldn’t send your enquiry. Please check your details and try again, or call us directly.');
        status.style.color = '#a02f3b';
      } finally {
        button.disabled = false;
        button.textContent = 'Send enquiry ↗';
      }
    });
  </script>
</Base>
