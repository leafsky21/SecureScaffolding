---
import Base from '../../layouts/Base.astro'; import { projects } from '../../data/projects';
export function getStaticPaths(){ return projects.map(project=>({params:{slug:project.slug},props:{project}})); }
const { project } = Astro.props;
---
<Base title={`${project.title} | Secure Scaffolding`} description={`${project.title}: ${project.category} project supported by Secure Scaffolding in ${project.location}.`}><main><section class="project-hero"><div class="wrap project-hero-grid"><div><a class="eyebrow back-link" href="/projects">← All projects</a><h1>{project.title}</h1><p class="project-meta">{project.location} · {project.category}</p><p class="lead">{project.description}</p><a class="btn btn-primary" href="/contact">Discuss your project ↗</a></div><img src={project.image} alt={project.title} /></div></section>{project.images && <section class="section" style="padding-bottom:0"><div class="wrap"><div class="section-head"><div><div class="eyebrow">Project gallery</div><h2>On-site access, up close.</h2></div></div><div class="detail-gallery">{project.images.map((image,index)=><img src={image} alt={`${project.title} project photo ${index+1}`} loading={index>1?'lazy':undefined} />)}</div></div></section>}<section class="section"><div class="wrap split"><div><div class="eyebrow">Services delivered</div><h2>Access that keeps work moving.</h2></div><div class="list">{project.services.map((service,index)=><div class="list-row"><span style="color:#98ab22;font-weight:900">0{index+1}</span><strong>{service}</strong></div>)}</div></div></section></main><style>.project-hero img{height:320px;max-height:320px}.projects-index-gallery{grid-template-columns:repeat(3,1fr);grid-auto-rows:190px}.projects-index-gallery figure{height:190px}.projects-index-gallery img{height:190px;max-height:190px}.detail-gallery{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}.detail-gallery img{width:100%;height:220px;object-fit:cover;border-radius:14px}.detail-gallery img:first-child{grid-column:span 2;grid-row:span 2;height:454px}@media(max-width:800px){.projects-index-gallery{grid-template-columns:repeat(2,1fr);grid-auto-rows:170px}.projects-index-gallery figure,.projects-index-gallery img{height:170px;max-height:170px}.project-hero img{height:280px;max-height:280px}.detail-gallery{grid-template-columns:repeat(2,1fr)}.detail-gallery img:first-child{grid-column:span 2;grid-row:auto;height:300px}}@media(max-width:480px){.projects-index-gallery{grid-template-columns:1fr;grid-auto-rows:220px}.projects-index-gallery figure,.projects-index-gallery img{height:220px;max-height:220px}.project-hero img{height:240px;max-height:240px}.detail-gallery{display:block}.detail-gallery img,.detail-gallery img:first-child{height:250px;margin-bottom:14px}}</style></Base>
