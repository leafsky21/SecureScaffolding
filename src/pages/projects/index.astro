---
import Base from '../../layouts/Base.astro'; import PageHeader from '../../components/PageHeader.astro'; import { sortedProjects as projects } from '../../data/projects';
---
<Base title="Projects | Secure Scaffolding" description="Selected scaffolding and access projects delivered by Secure Scaffolding across NSW." current="projects"><main><PageHeader eyebrow="Selected work" title="A track record you can see." intro="Explore a selection of infrastructure, commercial, residential and health projects supported by our team." /><section class="section" style="padding-top:0"><div class="wrap"><div class="project-gallery projects-index-gallery">{projects.map((project,index)=><a href={`/projects/${project.slug}`}><figure><img src={project.image} alt={project.title} loading={index>1?'lazy':undefined} /><figcaption><strong>{project.title}</strong><span>{project.category} ↗</span></figcaption></figure></a>)}</div></div></section></main><style>.projects-index-gallery{max-width:960px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:160px;gap:14px}.projects-index-gallery figure{height:160px;margin:0}.projects-index-gallery img{width:100%;height:160px;max-height:160px;object-fit:cover;display:block}@media(max-width:800px){.projects-index-gallery{grid-template-columns:repeat(2,1fr);grid-auto-rows:150px}.projects-index-gallery figure,.projects-index-gallery img{height:150px;max-height:150px}}@media(max-width:480px){.projects-index-gallery{grid-template-columns:1fr;grid-auto-rows:190px}.projects-index-gallery figure,.projects-index-gallery img{height:190px;max-height:190px}}</style></Base>
