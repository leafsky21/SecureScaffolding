---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import { sortedProjects as projects } from '../../data/projects';
---

<Base
  title="Scaffolding Projects Sydney & NSW | Secure Scaffolding"
  description="Explore bridge access, public access stairs, high-rise edge protection and commercial scaffolding projects delivered across Sydney and NSW."
  current="projects"
  image={projects[0].image}
  imageWidth={projects[0].imageWidth}
  imageHeight={projects[0].imageHeight}
>
  <main>
    <PageHeader
      eyebrow="Selected work"
      title="Scaffolding projects built around real site constraints."
      intro="Explore documented bridge, infrastructure, public access, commercial and high-rise edge-protection work delivered across Sydney and NSW."
    />
    <section class="section" style="padding-top:0">
      <div class="wrap">
        <div class="project-gallery projects-index-gallery">
          {projects.map((project, index) => (
            <a href={`/projects/${project.slug}/`}>
              <figure>
                <ResponsiveImage
                  src={project.image}
                  alt={project.imageAlts?.[0] ?? project.title}
                  width={project.imageWidth}
                  height={project.imageHeight}
                  sizes="(max-width: 480px) calc(100vw - 28px), (max-width: 800px) 50vw, 33vw"
                  loading={index > 1 ? 'lazy' : 'eager'}
                />
                <figcaption><strong>{project.title}</strong><span>{project.category} ↗</span></figcaption>
              </figure>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>

  <style>
    .projects-index-gallery{max-width:960px;margin:0 auto;display:grid;grid-template-columns:repeat(3,1fr);grid-auto-rows:210px;gap:22px}
    .projects-index-gallery figure{height:210px;margin:0;background:#fff}
    .projects-index-gallery img{width:100%;height:160px;max-height:160px;object-fit:cover;display:block}
    .projects-index-gallery figcaption{position:static;inset:auto;padding:10px 2px 0;background:#fff;color:var(--ink);display:block}
    .projects-index-gallery figcaption strong{display:block;line-height:1.2}
    .projects-index-gallery figcaption span{display:block;margin-top:5px;padding-left:0;color:var(--muted);font-size:.78rem;line-height:1.2}
    .projects-index-gallery a:hover figcaption strong{color:#6b7f00}
    @media(max-width:800px){
      .projects-index-gallery{grid-template-columns:repeat(2,1fr);grid-auto-rows:200px}
      .projects-index-gallery figure{height:200px}
      .projects-index-gallery img{height:150px;max-height:150px}
    }
    @media(max-width:480px){
      .projects-index-gallery{grid-template-columns:1fr;grid-auto-rows:230px}
      .projects-index-gallery figure{height:230px}
      .projects-index-gallery img{height:180px;max-height:180px}
    }
  </style>
</Base>
