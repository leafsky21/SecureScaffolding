---
import Base from '../layouts/Base.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import ResponsiveImage from '../components/ResponsiveImage.astro';

const description = 'Sydney scaffolding hire, installation, engineer-certified design and transport for commercial, civil, infrastructure and residential projects across NSW.';
---

<Base
  title="Scaffolding Sydney | Hire & Installation | Secure Scaffolding"
  description={description}
  current="home"
  image="/projects/prime-bluescope-erskine-park/IMG_6327.webp"
  imageWidth={1920}
  imageHeight={2560}
>
  <main>
    <section class="hero">
      <div class="wrap hero-grid">
        <div>
          <div class="eyebrow" style="color:#d7f54b">Sydney · Central Coast · Newcastle</div>
          <h1>Scaffolding hire and installation for serious Sydney projects.</h1>
          <p>Secure Scaffolding provides scaffold hire, engineer-certified design, professional installation and transport for builders, contractors and government projects across Greater Sydney and regional NSW.</p>
          <div class="hero-actions">
            <a class="btn btn-primary" href="/contact/">Request a quote ↗</a>
            <a class="btn" style="color:#fff;border-color:#596166" href="/services/">Explore scaffolding services</a>
          </div>
        </div>
        <div class="hero-art">
          <ResponsiveImage src="/projects/prime-bluescope-erskine-park/IMG_6327.webp" alt="Scaffolding installed alongside the BlueScope manufacturing facility for Prime Constructions at Erskine Park" width={1920} height={2560} sizes="(max-width: 480px) calc(100vw - 28px), 390px" loading="eager" fetchpriority="high" />
        </div>
      </div>
    </section>

    <div class="strip">
      <div class="wrap strip-inner">
        <span>Australian-owned</span>
        <span>Established 1996</span>
        <span>Projects of every scale</span>
      </div>
    </div>

    <section class="section home-services">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow">Sydney scaffolding services</div>
            <h2>One experienced team. Every access challenge.</h2>
          </div>
          <p class="lead">From equipment hire and installation to engineered specialist access, we coordinate the people, materials and planning needed to keep work moving.</p>
        </div>
        <div class="home-service-grid">
          <a class="home-service-card" href="/services/scaffolding-hire-sydney/">
            <span>01</span>
            <h3>Scaffolding hire and installation</h3>
            <p>Scaffold supply, delivery, professional installation, adjustments and dismantling for Sydney construction projects.</p>
            <strong>Explore scaffold hire ↗</strong>
          </a>
          <a class="home-service-card" href="/services/commercial-scaffolding-sydney/">
            <span>02</span>
            <h3>Commercial scaffolding</h3>
            <p>Planned access systems for commercial builders, industrial facilities, health projects and active operational sites.</p>
            <strong>Explore commercial scaffolding ↗</strong>
          </a>
          <a class="home-service-card" href="/services/">
            <span>03</span>
            <h3>Specialist access solutions</h3>
            <p>Premium public access stairs, bridge access scaffolding, temporary edge protection and engineer-supported design.</p>
            <strong>View all specialist services ↗</strong>
          </a>
        </div>
        <div class="specialist-links" aria-label="Specialist scaffolding services">
          <a href="/services/public-access-stairs-sydney/">Premium public access stairs</a>
          <a href="/services/bridge-access-scaffolding-sydney/">Bridge access scaffolding</a>
          <a href="/services/temporary-edge-protection-sydney/">Temporary edge protection</a>
        </div>
      </div>
    </section>

    <section class="section coverage-section">
      <div class="wrap coverage-grid">
        <div>
          <div class="eyebrow">Areas we serve</div>
          <h2>Scaffolding across Sydney and regional NSW.</h2>
          <p class="lead">Based at 5 Gundah Road in Mount Kuring-Gai, our team supports projects throughout Greater Sydney, the Central Coast and Newcastle.</p>
          <a class="btn btn-dark" href="/service-areas/">Explore our service areas ↗</a>
        </div>
        <div class="coverage-list">
          <article><strong>Greater Sydney</strong><p>North Shore, Western Sydney, Sydney metro and project locations across the wider metropolitan area.</p></article>
          <article><strong>Central Coast</strong><p>Scaffold hire, installation and specialist access coordinated for suitable construction and infrastructure projects.</p></article>
          <article><strong>Newcastle</strong><p>Project-based scaffolding and access support for builders, contractors and infrastructure teams.</p></article>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow">Selected work</div>
            <h2>Scaffolding experience you can see.</h2>
          </div>
          <p class="lead">Explore access solutions delivered for bridge, commercial, industrial, education, health and high-rise environments.</p>
        </div>
        <ProjectGallery />
      </div>
    </section>

    <section class="section band">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow" style="color:#d7f54b">A track record that travels</div>
            <h2>Trusted across major projects.</h2>
          </div>
          <p class="lead">Secure Scaffolding has worked alongside leading builders, contractors and government bodies since 1996.</p>
        </div>
        <div class="stats">
          <div class="stat"><strong>1996</strong><span>Founded in Sydney</span></div>
          <div class="stat"><strong>NSW</strong><span>Project coverage</span></div>
          <div class="stat"><strong>5</strong><span>Core access services</span></div>
          <div class="stat"><strong>1</strong><span>Reliable point of contact</span></div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap split">
        <div>
          <div class="eyebrow">Ready when you are</div>
          <h2>Plan safe access for your next project.</h2>
        </div>
        <div>
          <p class="lead">Tell us what you’re building, where the site is and what access you need. We’ll help you identify a practical scaffolding solution.</p>
          <a class="btn btn-dark" href="/contact/">Request a scaffolding quote ↗</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .home-service-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
  .home-service-card{display:flex;flex-direction:column;min-width:0;min-height:310px;padding:28px;border:1px solid var(--line);border-top:3px solid var(--lime);border-radius:18px;background:#fff;transition:.2s}
  .home-service-card:hover{transform:translateY(-3px);border-color:#b8cc36;box-shadow:0 12px 30px rgba(16,17,18,.08)}
  .home-service-card>span{color:#7d901b;font-weight:900}
  .home-service-card h3{font-size:1.55rem;line-height:1.08;letter-spacing:-.04em;margin:42px 0 10px}
  .home-service-card p{color:var(--muted);margin:0 0 24px}
  .home-service-card strong{margin-top:auto;font-size:.85rem;color:#607300}
  .specialist-links{display:flex;flex-wrap:wrap;gap:12px 24px;margin-top:24px;padding-top:22px;border-top:1px solid var(--line)}
  .specialist-links a{font-weight:850;color:#607300}
  .coverage-section{background:#f0f2ed}
  .coverage-grid{display:grid;grid-template-columns:minmax(0,.9fr) minmax(360px,1.1fr);gap:clamp(36px,7vw,90px);align-items:start}
  .coverage-grid h2{margin-bottom:22px}
  .coverage-grid .btn{margin-top:18px}
  .coverage-list{border-top:1px solid var(--line)}
  .coverage-list article{display:grid;grid-template-columns:150px 1fr;gap:24px;padding:22px 0;border-bottom:1px solid var(--line)}
  .coverage-list strong{font-size:1.05rem}
  .coverage-list p{color:var(--muted);margin:0}
  @media(max-width:900px){
    .home-service-grid{grid-template-columns:1fr}
    .home-service-card{min-height:0}
    .coverage-grid{grid-template-columns:1fr}
  }
  @media(max-width:520px){
    .coverage-list article{grid-template-columns:1fr;gap:6px}
  }
</style>
