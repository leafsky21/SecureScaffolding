---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import GlobalCTA from '../../components/GlobalCTA.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';

const siteUrl = 'https://www.securescaffolding.com.au';
const pageUrl = `${siteUrl}/services/public-access-stairs-sydney/`;
const title = 'Public Access Stairs Sydney | Secure Scaffolding';
const description = 'Premium temporary public access stair systems for schools and high-traffic sites across Sydney, with engineered landings, handrails, guardrails and slip-resistant surfaces.';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Services', item: `${siteUrl}/services/` },
        { '@type': 'ListItem', position: 3, name: 'Public Access Stairs Sydney', item: pageUrl }
      ]
    },
    {
      '@type': 'Service',
      name: 'Premium Public Access Stairs Sydney',
      description,
      url: pageUrl,
      serviceType: [
        'Temporary public access stairs',
        'School pedestrian access systems',
        'High-traffic temporary stair systems',
        'Scaffold-supported public access stairs'
      ],
      areaServed: [
        { '@type': 'City', name: 'Sydney' },
        { '@type': 'AdministrativeArea', name: 'New South Wales' }
      ],
      provider: { '@id': `${siteUrl}/#business` }
    }
  ]
};
---

<Base title={title} description={description} current="services" image="/projects/mount-st-benedict-college/IMG_4220.webp" jsonLd={schema}>
  <main>
    <PageHeader
      eyebrow="Premium public access stairs Sydney"
      title="Temporary stairs purpose-built for public access."
      intro="Premium pedestrian access systems for schools, public environments and high-traffic sites—designed for students, staff, visitors and the general public."
    />

    <section class="section service-intro" style="padding-top:0">
      <div class="wrap service-intro-grid">
        <ResponsiveImage src="/projects/mount-st-benedict-college/IMG_4220.webp" alt="Premium temporary public access stair system installed at Mount St Benedict College" width={1920} height={1528} sizes="(max-width: 800px) calc(100vw - 28px), 55vw" loading="eager" fetchpriority="high" />
        <div>
          <div class="eyebrow">Public use, not ordinary site access</div>
          <h2>A premium-quality pedestrian stair system.</h2>
          <p class="lead">Public access stairs serve a different purpose from conventional construction-site or stretcher stairs used primarily by tradespeople. They are configured for regular pedestrian use, with a clear route, generous landings and continuous edge protection.</p>
          <p>Secure Scaffolding plans each temporary public access system around the site layout, pedestrian volume and applicable public-access requirements. Project-specific design and certification can be coordinated where required.</p>
          <a class="btn btn-dark" href="/contact/">Discuss public access stairs ↗</a>
        </div>
      </div>
    </section>

    <section class="section feature-section">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow">Public-access features</div>
            <h2>Designed around the people using it.</h2>
          </div>
          <p class="lead">A complete temporary route for schools and other public-facing environments where safe, comfortable pedestrian movement matters.</p>
        </div>
        <div class="feature-grid">
          <article><span>01</span><h3>Public and high-traffic use</h3><p>Configured for students, staff, visitors and other members of the public moving through an active site.</p></article>
          <article><span>02</span><h3>Wide flights and landings</h3><p>Generous stair widths and level landings provide a practical pedestrian route across changing ground levels.</p></article>
          <article><span>03</span><h3>Handrails and guardrails</h3><p>Continuous handrails and guarded edges support controlled movement along stairs, turns and landings.</p></article>
          <article><span>04</span><h3>Slip-resistant surfaces</h3><p>Slip-resistant flooring and high-visibility step nosings improve footing and make stair edges easier to identify.</p></article>
        </div>
      </div>
    </section>

    <section class="section project-proof">
      <div class="wrap project-proof-grid">
        <div>
          <div class="eyebrow">Project example</div>
          <h2>Mount St Benedict College.</h2>
          <p class="lead">A premium temporary public access system installed for teachers, students and visitors, with multiple flights, generous landings, guardrails and slip-resistant surfaces.</p>
          <a class="text-link" href="/projects/mount-st-benedict-college-public-stair-access/">View the public access stair project ↗</a>
        </div>
        <div class="project-images">
          <ResponsiveImage src="/projects/mount-st-benedict-college/IMG_4243.webp" alt="Wide public access stair flights with guarded landings at Mount St Benedict College" width={1920} height={2560} sizes="(max-width: 560px) calc(100vw - 28px), (max-width: 800px) 50vw, 35vw" />
          <ResponsiveImage src="/projects/mount-st-benedict-college/IMG_4223.webp" alt="Guardrailed public access stair landing overlooking Mount St Benedict College" width={1920} height={1440} sizes="(max-width: 560px) calc(100vw - 28px), (max-width: 800px) 50vw, 35vw" />
        </div>
      </div>
    </section>

    <div class="wrap"><GlobalCTA /></div>
  </main>
</Base>

<style>
  .service-intro-grid{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(300px,.95fr);gap:clamp(30px,6vw,78px);align-items:center}
  .service-intro-grid>*,.project-proof-grid>*{min-width:0}
  .service-intro img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:20px}
  .service-intro h2{font-size:clamp(2.3rem,4.5vw,4.5rem)}
  .service-intro p:not(.lead){color:var(--muted);margin:18px 0 28px}
  .feature-section{background:#f0f2ed}
  .feature-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}
  .feature-grid article{min-width:0;padding:28px;border:1px solid var(--line);border-radius:16px;background:#fff;border-top:3px solid #e4f04a}
  .feature-grid span{color:#7d901b;font-weight:900}
  .feature-grid h3{font-size:1.35rem;letter-spacing:-.035em;margin:36px 0 10px}
  .feature-grid p{color:var(--muted);margin:0}
  .project-proof-grid{display:grid;grid-template-columns:minmax(280px,.7fr) minmax(0,1.3fr);gap:clamp(30px,6vw,78px);align-items:center}
  .project-proof h2{margin:12px 0 18px}
  .project-images{display:grid;grid-template-columns:1fr 1fr;gap:14px}
  .project-images img{display:block;width:100%;height:360px;object-fit:cover;border-radius:16px}
  .text-link{display:inline-block;margin-top:10px;font-weight:900;color:#607300}
  @media(max-width:800px){
    .service-intro-grid,.project-proof-grid{grid-template-columns:1fr}
    .project-proof-grid{gap:28px}
  }
  @media(max-width:560px){
    .feature-grid,.project-images{grid-template-columns:1fr}
    .project-images img{height:280px}
  }
</style>
