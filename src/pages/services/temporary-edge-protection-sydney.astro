---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import GlobalCTA from '../../components/GlobalCTA.astro';

const siteUrl = 'https://www.securescaffolding.com.au';
const pageUrl = `${siteUrl}/services/temporary-edge-protection-sydney/`;
const title = 'Temporary Edge Protection Sydney | Secure Scaffolding';
const description = 'Temporary edge protection systems for high-rise and commercial construction across Sydney and NSW, including concrete slab edges, shaft openings and perimeter barriers.';
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Services', item: `${siteUrl}/services/` },
        { '@type': 'ListItem', position: 3, name: 'Temporary Edge Protection Sydney', item: pageUrl }
      ]
    },
    {
      '@type': 'Service',
      name: 'Temporary Edge Protection Sydney',
      description,
      url: pageUrl,
      serviceType: [
        'Temporary edge protection systems',
        'Concrete slab edge protection',
        'Shaft opening edge protection',
        'High-rise perimeter edge protection'
      ],
      areaServed: [
        { '@type': 'City', name: 'Sydney' },
        { '@type': 'AdministrativeArea', name: 'New South Wales' }
      ],
      provider: {
        '@type': 'Organization',
        name: 'Secure Scaffolding',
        url: `${siteUrl}/`
      }
    }
  ]
};
---

<Base title={title} description={description} current="services" image="/projects/oran-park-edge-protection/131.webp" jsonLd={schema}>
  <main>
    <PageHeader
      eyebrow="Temporary edge protection Sydney"
      title="Temporary edge protection systems for Sydney construction sites."
      intro="Practical perimeter barriers for high-rise and commercial projects, installed around exposed concrete slab edges, shaft openings and other fall edges."
    />

    <section class="section overview" style="padding-top:0">
      <div class="wrap split">
        <div>
          <div class="eyebrow">Where protection is needed</div>
          <h2>Slab edges, shaft openings and exposed perimeters.</h2>
        </div>
        <div>
          <p class="lead">Secure Scaffolding supplies and installs temporary edge protection systems for high-rise and commercial construction across Sydney and NSW. Our modular mesh barriers provide a physical barrier around exposed concrete slab edges, shaft openings and building perimeters while work continues.</p>
          <p>Each installation is planned around the supporting surface, connection points and changing site conditions, with adjustments coordinated as the build progresses.</p>
          <a class="btn btn-dark" href="/contact/">Discuss edge protection ↗</a>
        </div>
      </div>
    </section>

    <section class="section edge-types">
      <div class="wrap">
        <div class="section-head">
          <div>
            <div class="eyebrow">Edge-protection applications</div>
            <h2>Temporary barriers configured for the project.</h2>
          </div>
          <p class="lead">A practical construction edge-protection solution for active floor plates, openings and changing high-rise conditions.</p>
        </div>
        <div class="edge-grid">
          <article>
            <span>01</span>
            <h3>Concrete slab edges</h3>
            <p>Clamp-mounted and project-specific barrier layouts for exposed suspended slab perimeters.</p>
          </article>
          <article>
            <span>02</span>
            <h3>Shaft openings</h3>
            <p>Mesh barriers around open lift, service and construction shaft edges.</p>
          </article>
          <article>
            <span>03</span>
            <h3>High-rise perimeters</h3>
            <p>Continuous temporary edge protection for elevated work areas and active floor plates.</p>
          </article>
          <article>
            <span>04</span>
            <h3>Installation and adjustment</h3>
            <p>Coordinated installation and repositioning as slab, shaft and access conditions change.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="section project-proof">
      <div class="wrap project-proof-grid">
        <img src="/projects/oran-park-edge-protection/131.webp" alt="Blue modular mesh edge-protection barrier clamped to a concrete slab edge at an Oran Park high-rise building" loading="lazy" decoding="async" />
        <div>
          <div class="eyebrow">Recent project</div>
          <h2>High-Rise Edge Protection — Oran Park</h2>
          <p class="lead">Temporary mesh barriers installed along exposed concrete slab edges, shaft openings and high-rise perimeters at an Oran Park construction project.</p>
          <a class="text-link" href="/projects/oran-park-high-rise-edge-protection/">View the Oran Park edge-protection project ↗</a>
        </div>
      </div>
    </section>

    <div class="wrap"><GlobalCTA /></div>
  </main>
</Base>

<style>
  .overview p:not(.lead){color:var(--muted);max-width:62ch;margin:18px 0 28px}
  .edge-types{background:#f2f3ef}
  .edge-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:14px;margin-top:36px}
  .edge-grid article{background:#fff;border:1px solid var(--line);border-radius:16px;padding:28px;min-height:210px}
  .edge-grid span{color:#7d901b;font-weight:900}
  .edge-grid h3{font-size:1.35rem;letter-spacing:-.035em;margin:38px 0 10px}
  .edge-grid p{color:var(--muted);margin:0;max-width:48ch}
  .project-proof-grid{display:grid;grid-template-columns:minmax(0,1.25fr) minmax(280px,.75fr);gap:clamp(28px,6vw,80px);align-items:center}
  .project-proof img{width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:18px}
  .project-proof h2{margin:12px 0 18px}
  .text-link{display:inline-block;margin-top:10px;font-weight:900;color:#607300}
  @media(max-width:800px){
    .edge-grid,.project-proof-grid{grid-template-columns:1fr}
    .project-proof-grid{gap:28px}
  }
  @media(max-width:480px){
    .edge-grid{grid-template-columns:1fr}
    .edge-grid article{min-height:0}
  }
</style>
