---
import Base from '../layouts/Base.astro'; import PageHeader from '../components/PageHeader.astro';
const clients=[['Grindley Construction Pty Ltd','Construction'],['Red Eye Constructions','Construction'],['Prime Constructions Pty Ltd','Construction'],['Freecity Group','Development'],['Nationwide Oil Pty Ltd','Industrial'],['Rudder Homes','Residential'],['Hines Constructions','Construction'],['DJ Thompson Pty Ltd','Construction'],['James Clifford Constructions Pty Ltd','Construction'],['Dreambuild','Residential'],['Adco Constructions Pty Ltd','Construction'],['Crystal Pools Pty Ltd','Specialist'],['BlueScope Steel Limited','Steel manufacturing'],['Abode Constructions (NSW) Pty Ltd','Residential'],['Yisheng Construction','Construction']];
---
<Base title="Clients | Secure Scaffolding" description="A selection of builders, contractors and industry leaders who have worked with Secure Scaffolding." current="clients"><main><PageHeader eyebrow="Selected clients" title="Good company, good work." intro="Our reputation has been built project by project, alongside teams who value reliability, safety and care." /><section class="section" style="padding-top:0"><div class="wrap"><div class="client-stats"><div><strong>15+</strong><span>organisations supported</span></div><div><strong>28+</strong><span>years of experience</span></div><div><strong>NSW</strong><span>project coverage</span></div></div><div class="client-grid client-cards">{clients.map(([client,category],index)=><article class="client-card"><div class="client-card-top"><span class="client-index">{String(index+1).padStart(2,'0')}</span><span class="client-tag">{category}</span></div><h2>{client}</h2><p>Trusted project partner</p></article>)}</div><div class="client-cta"><div><div class="eyebrow">Planning a project?</div><h2>Let’s make safe access part of the plan.</h2><p>Tell us what you’re building and where. We’ll help you find a practical way forward.</p></div><a class="btn btn-dark" href="/contact">Request a quote ↗</a></div></div></section></main><style>.client-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:38px}.client-stats>div{padding:20px 0;border-top:1px solid var(--line)}.client-stats strong{display:block;font-size:2.1rem;letter-spacing:-.05em}.client-stats span{color:var(--muted);font-size:.82rem;text-transform:uppercase;letter-spacing:.08em}.client-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;border-top:0}.client-card{min-height:178px;padding:22px;border:1px solid var(--line);border-radius:16px;background:#fff;transition:.2s}.client-card:hover{transform:translateY(-3px);border-color:#b8cc36;box-shadow:0 12px 30px rgba(16,17,18,.08)}.client-card-top{display:flex;justify-content:space-between;align-items:center}.client-index{font-weight:900;color:#98ab22}.client-tag{font-size:.66rem;text-transform:uppercase;letter-spacing:.08em;color:#68736f;border:1px solid var(--line);border-radius:999px;padding:4px 8px}.client-card h2{font-size:1.08rem;line-height:1.2;letter-spacing:-.03em;margin:38px 0 8px}.client-card p{margin:0;color:var(--muted);font-size:.85rem}.client-cta{display:flex;align-items:center;justify-content:space-between;gap:30px;margin-top:48px;padding:30px;border-radius:18px;background:var(--ink);color:#fff}.client-cta h2{max-width:530px;font-size:clamp(1.8rem,4vw,3.2rem);line-height:1;letter-spacing:-.06em;margin:10px 0}.client-cta p{color:#c8ced0;margin:0}.client-cta .eyebrow{color:var(--lime)}@media(max-width:800px){.client-cards{grid-template-columns:repeat(2,1fr)}.client-cta{display:block}.client-cta .btn{margin-top:24px}}@media(max-width:480px){.client-stats{grid-template-columns:1fr}.client-cards{grid-template-columns:1fr}}</style></Base>
