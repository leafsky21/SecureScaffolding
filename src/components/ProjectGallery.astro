---
import { sortedProjects as projects } from '../data/projects';
---
<div class="project-gallery-wrap" style="max-width:1000px;margin-inline:auto"><div class="project-gallery">{projects.slice(0, 5).map((project, index) => <a href={`/projects/${project.slug}`} class:list={{ 'project-feature': index === 0 || index === 3 }}><figure><img src={project.image} alt={project.title} loading={index > 1 ? 'lazy' : undefined} style="max-height:360px" /><figcaption><strong>{project.title}</strong><span style="display:block;margin-top:4px">{project.category} ↗</span></figcaption></figure></a>)}</div>{projects.length > 5 && <><div class="project-gallery project-gallery-more" hidden>{projects.slice(5).map(project => <a href={`/projects/${project.slug}`}><figure><img src={project.image} alt={project.title} loading="lazy" style="max-height:360px" /><figcaption><strong>{project.title}</strong><span style="display:block;margin-top:4px">{project.category} ↗</span></figcaption></figure></a>)}</div><button class="btn btn-dark gallery-toggle" type="button" aria-expanded="false">Show more projects ↓</button></>}</div><script>document.querySelectorAll('.gallery-toggle').forEach((button)=>button.addEventListener('click',()=>{const more=button.previousElementSibling;if(!more)return;const open=more.hasAttribute('hidden');if(open)more.removeAttribute('hidden');else more.setAttribute('hidden','');button.setAttribute('aria-expanded',String(open));button.textContent=open?'Show fewer projects ↑':'Show more projects ↓'}));</script>
