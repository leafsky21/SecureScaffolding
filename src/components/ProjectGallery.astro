---
import { sortedProjects as projects } from '../data/projects';
---
<div class="project-gallery">{projects.map((project, index) => <a href={`/projects/${project.slug}`} class:list={{ 'project-feature': index === 0 || index === 3 }}><figure><img src={project.image} alt={project.title} loading={index > 1 ? 'lazy' : undefined} /><figcaption><strong>{project.title}</strong><span>{project.category} ↗</span></figcaption></figure></a>)}</div>
