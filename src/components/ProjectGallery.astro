---
import { sortedProjects as projects } from '../data/projects';
import ResponsiveImage from './ResponsiveImage.astro';
---
<div class="project-gallery-wrap" style="max-width:1000px;margin-inline:auto"><div class="project-gallery">{projects.slice(0, 5).map((project, index) => <a href={`/projects/${project.slug}/`} class:list={{ 'project-feature': index === 0 || index === 3 }}><figure><ResponsiveImage src={project.image} alt={project.imageAlts?.[0] ?? project.title} width={project.imageWidth} height={project.imageHeight} sizes={index === 0 || index === 3 ? '(max-width: 800px) calc(100vw - 28px), 50vw' : '(max-width: 800px) 50vw, 25vw'} loading={index > 1 ? 'lazy' : 'eager'} style="max-height:360px" /><figcaption><strong>{project.title}</strong><span style="display:block;margin-top:4px">{project.category} ↗</span></figcaption></figure></a>)}</div>{projects.length > 5 && <><div class="project-gallery project-gallery-more" hidden>{projects.slice(5).map(project => <a href={`/projects/${project.slug}/`}><figure><ResponsiveImage src={project.image} alt={project.imageAlts?.[0] ?? project.title} width={project.imageWidth} height={project.imageHeight} sizes="(max-width: 800px) 50vw, 25vw" style="max-height:360px" /><figcaption><strong>{project.title}</strong><span style="display:block;margin-top:4px">{project.category} ↗</span></figcaption></figure></a>)}</div><button class="btn btn-dark gallery-toggle" type="button" aria-expanded="false">Show more projects ↓</button></>}</div><script>document.querySelectorAll('.gallery-toggle').forEach((button)=>button.addEventListener('click',()=>{const more=button.previousElementSibling;if(!more)return;const open=more.hasAttribute('hidden');if(open)more.removeAttribute('hidden');else more.setAttribute('hidden','');button.setAttribute('aria-expanded',String(open));button.textContent=open?'Show fewer projects ↑':'Show more projects ↓'}));</script>
