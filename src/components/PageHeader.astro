---
import BusinessSchema from './BusinessSchema.astro';
const { eyebrow, title, intro } = Astro.props;
---
<BusinessSchema /><section class="section page-header-section"><div class="wrap section-head"><div><div class="eyebrow">{eyebrow}</div><h1>{title}</h1></div>{intro && <p class="lead">{intro}</p>}</div></section>
