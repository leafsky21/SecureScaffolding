---
import '../styles/global.css';
const { title, description, current = '' } = Astro.props;
const nav = [{href:'/',label:'Home'},{href:'/about',label:'About'},{href:'/services',label:'Services'},{href:'/clients',label:'Clients'},{href:'/contact',label:'Contact'}];
---
<!doctype html><html lang="en-AU"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width" /><title>{title}</title><meta name="description" content={description} /><link rel="canonical" href={`https://www.securescaffolding.com.au${Astro.url.pathname === '/' ? '/' : Astro.url.pathname}`} /><meta name="theme-color" content="#101112" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /></head><body>
<header class="site-header"><div class="wrap nav"><a class="brand" href="/"><span class="brand-mark">↗</span><span>Secure Scaffolding<small>Services Pty Ltd</small></span></a><button class="menu" aria-label="Open menu" aria-expanded="false">☰</button><nav class="nav-links" aria-label="Main navigation">{nav.map(item=><a href={item.href} aria-current={current===item.label.toLowerCase()?'page':undefined}>{item.label}</a>)}<a class="btn btn-dark" href="/contact">Request a quote</a></nav></div></header>
<slot /><footer class="site-footer"><div class="wrap footer-inner"><span><strong>Secure Scaffolding Services Pty Ltd</strong><br />Sydney, NSW · ABN 26 679 229 924</span><span>Built for safe access, from ground up.</span></div></footer><script>const b=document.querySelector('.menu'),n=document.querySelector('.nav-links');b?.addEventListener('click',()=>{const o=n.classList.toggle('open');b.setAttribute('aria-expanded',String(o))});</script></body></html>
