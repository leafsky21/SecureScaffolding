---
import '../styles/global.css';
import '../styles/overrides.css';
import BusinessSchema from '../components/BusinessSchema.astro';

const { title, description, current = '', image, imageWidth, imageHeight, type = 'website', publishedTime, jsonLd } = Astro.props;
const siteUrl = 'https://www.securescaffolding.com.au';
const canonicalPath = Astro.url.pathname === '/' ? '/' : `${Astro.url.pathname.replace(/\/+$/, '')}/`;
const canonicalUrl = new URL(canonicalPath, siteUrl).toString();
const socialImage = image ? new URL(image, siteUrl).toString() : undefined;
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: title,
  description,
  isPartOf: { '@id': `${siteUrl}/#website` },
  about: { '@id': `${siteUrl}/#business` },
  inLanguage: 'en-AU',
  ...(socialImage ? {
    primaryImageOfPage: {
      '@type': 'ImageObject',
      url: socialImage,
      ...(imageWidth ? { width: imageWidth } : {}),
      ...(imageHeight ? { height: imageHeight } : {})
    }
  } : {})
};
const nav = [
  { href: '/', label: 'Home' },
  { href: '/about/', label: 'About' },
  { href: '/services/', label: 'Services' },
  { href: '/projects/', label: 'Projects' },
  { href: '/clients/', label: 'Clients' }
];
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en-AU" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=2" />
    <meta name="theme-color" content="#101112" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Secure Scaffolding" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:alt" content={title} />}
    {socialImage && imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
    {socialImage && imageHeight && <meta property="og:image:height" content={String(imageHeight)} />}
    {type === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}
    <BusinessSchema />
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <style>
      .brand img{width:48px;height:48px;object-fit:contain;border-radius:8px;background:#fff}
      .brand-mark{display:none}
      .project-gallery{display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:180px;gap:14px}
      .project-gallery figure{position:relative;margin:0;overflow:hidden;border-radius:16px;background:#202326}
      .project-gallery figure.project-feature{grid-column:span 2;grid-row:span 2}
      .project-gallery img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .4s}
      .project-gallery figure:hover img{transform:scale(1.05)}
      .project-gallery figcaption{position:absolute;inset:auto 12px 12px 12px;padding:12px 14px;border-radius:10px;background:rgba(16,17,18,.82);color:#fff;display:grid;gap:2px}
      .project-gallery figcaption strong{font-size:.9rem}
      .project-gallery figcaption span{font-size:.72rem;color:#d7f54b;text-transform:uppercase;letter-spacing:.08em}
      .project-hero{padding:76px 0;background:var(--ink);color:#fff}
      .project-hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:64px;align-items:center}
      .project-hero h1{font-size:clamp(3rem,6vw,6rem);line-height:.95;letter-spacing:-.06em;margin:18px 0}
      .project-hero .lead{color:#c8ced0;margin:24px 0 30px}
      .project-hero img{width:100%;height:470px;object-fit:cover;border-radius:22px;box-shadow:16px 16px 0 #31363a}
      .project-meta{color:var(--lime);font-weight:800;letter-spacing:.1em;text-transform:uppercase;font-size:.8rem}
      .back-link{color:var(--lime)}
      @media(max-width:800px){
        .project-gallery{grid-template-columns:repeat(2,1fr);grid-auto-rows:170px}
        .project-gallery figure.project-feature{grid-column:span 2;grid-row:span 1}
        .project-hero-grid{grid-template-columns:1fr;gap:38px}
        .project-hero img{height:300px}
      }
      @media(max-width:480px){
        .project-gallery{display:block}
        .project-gallery figure{height:250px;margin-bottom:14px}
      }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap nav">
        <a class="brand" href="/" aria-label="Secure Scaffolding home">
          <img src="/secure-scaffolding-logo.webp" width="48" height="48" alt="Secure Scaffolding" />
          <span>Secure Scaffolding<small>Services Pty Ltd</small></span>
        </a>
        <button class="menu" aria-label="Open menu" aria-expanded="false">☰</button>
        <nav class="nav-links" aria-label="Main navigation">
          {nav.map(item => <a href={item.href} aria-current={current === item.label.toLowerCase() ? 'page' : undefined}>{item.label}</a>)}
          <a class="btn btn-dark" href="/contact/">Request a quote</a>
        </nav>
      </div>
    </header>
    <slot />
    <footer class="site-footer">
      <div class="wrap footer-inner">
        <address>
          <strong>Secure Scaffolding Services Pty Ltd</strong><br />
          5 Gundah Road, Mount Kuring-Gai NSW 2080<br />
          <a href="tel:+61294570133">02 9457 0133</a> · <a href="mailto:info@securescaffolding.com.au">info@securescaffolding.com.au</a><br />
          ABN 26 679 229 924
        </address>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/services/">Scaffolding services</a>
          <a href="/service-areas/">Service areas</a>
          <a href="/projects/">Project experience</a>
          <a href="/contact/">Request a quote</a>
        </nav>
        <span class="footer-tagline">Built for safe access, from the ground up.</span>
      </div>
    </footer>
    <script>
      const b = document.querySelector('.menu');
      const n = document.querySelector('.nav-links');
      b?.addEventListener('click', () => {
        const o = n.classList.toggle('open');
        b.setAttribute('aria-expanded', String(o));
      });
    </script>
  </body>
</html>
